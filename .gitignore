# ==========================================
# TrustWipe - Git Ignore
# ==========================================

# --------------------
# Dependencies
# --------------------
node_modules/
backend/node_modules/
frontend/node_modules/

# --------------------
# Environment variables
# --------------------
.env
.env.*
!.env.example
backend/.env
frontend/.env

# --------------------
# RSA / Private Keys
# --------------------
backend/private.pem
backend/public.pem
*.pem

# --------------------
# Logs
# --------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# --------------------
# Build files
# --------------------
dist/
dist-ssr/
frontend/dist/
.output/
.next/
.nuxt/
.cache/
.parcel-cache/
.vite/

# --------------------
# OS files
# --------------------
.DS_Store
Thumbs.db

# --------------------
# IDE / Editor files
# --------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --------------------
# Generated certificates
# --------------------
backend/certificates/*.pdf

# --------------------
# Temporary files
# --------------------
*.tmp
*.local

# --------------------
# Coverage
# --------------------
coverage/
*.lcov
.nyc_output

# --------------------
# TypeScript
# --------------------
*.tsbuildinfo

# --------------------
# npm / Yarn
# --------------------
.npm/
*.tgz
.yarn-integrity
.pnp.*
.yarn/*

# --------------------
# Other caches
# --------------------
.grunt/
bower_components/
jspm_packages/
web_modules/
.svelte-kit/
.temp/